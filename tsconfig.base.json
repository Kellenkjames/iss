{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@iss/component-kernel": ["./libs/platform/component-kernel/src/index.ts"],
      "@iss/component-kernel/*": ["./libs/platform/component-kernel/src/*"],
      "@iss/component-kernel/register": ["./libs/platform/component-kernel/src/register.ts"],
      "@iss/design-tokens": ["./libs/platform/design-tokens/src/index.ts"],
      "@iss/design-tokens/*": ["./libs/platform/design-tokens/src/*"],
      "@iss/design-tokens/styles.css": ["./libs/platform/design-tokens/src/styles.css"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
